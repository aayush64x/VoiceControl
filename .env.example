# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real keys.
# Needs Amazon Bedrock access to Claude Haiku 4.5 and Claude Sonnet 4.5 in us-east-1.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Only for temporary credentials (e.g. AWS Workshop Studio); delete the line otherwise
AWS_SESSION_TOKEN=your-session-token
