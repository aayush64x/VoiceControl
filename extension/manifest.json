{
  "manifest_version": 3,
  "name": "VOYA",
  "version": "0.1",
  "description": "VOYA: you say the goal, VOYA does the clicks. A voice-first browser agent for people who can't easily use a mouse or keyboard.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "tabs",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open VOYA"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-mic": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Open VOYA and start or stop listening"
    }
  }
}
