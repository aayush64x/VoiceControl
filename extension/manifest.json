{
  "manifest_version": 3,
  "name": "Voice Browser Agent",
  "version": "0.1",
  "description": "Voice-controlled browser agent for accessibility",
  "permissions": ["activeTab", "sidePanel", "scripting"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Voice Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
